<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9 (API 28) and later block cleartext HTTP by default, which
         silently kills every call to the local Spring Boot server over
         http://. Enabled for debug builds ONLY — release builds keep the
         secure default and must talk to the API over HTTPS. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
